# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — client build sırasında üretilir (npm run build)
/generated

# kişisel session kayıtları — takımda merge conflict yaratmasın diye takip edilmez
/docs/sessions.md
/docs/sessions/

# obsidian vault ayarları (notların kendisi Obsidian/ altında takip edilir)
.obsidian/

#impeccable
.impeccable
impeccable
# vendored impeccable skill dosyaları — repoya girmez, karar ertelendi
/.claude/rules/skills/
