// Model adları PascalCase, tablo adları @@map ile snake_case.
// Veri modelinin anlatımı: docs/codemap.md

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7'de bağlantı adresi şemada durmaz: CLI için prisma.config.ts,
// çalışma zamanı için PrismaClient'a verilen adapter taşır.
datasource db {
  provider = "postgresql"
}

// ---------- Ortak ----------

// Tüm fotoğraf blokları buradan beslenir. Diyagramda 1-1 çizilmişti;
// aynı görselin birden çok blokta kullanılabilmesi için 1-N bırakıldı.
model Media {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  landingPages  LandingPage[]
  aboutSections AboutSection[]
  projects      Project[]
  projectImages ProjectImage[]

  @@map("media")
}

// ---------- LandingPage ----------

// "Projeler + (sayısı)" bloğu projects tablosundan COUNT ile hesaplanır, ayrı kolon yok.
model LandingPage {
  id          Int      @id @default(autoincrement())
  welcomeText String   @map("welcome_text")
  photoId     Int?     @map("photo_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  photo Media? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@map("landing_page")
}

model TechStackItem {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(60)
  icon  String @db.VarChar(60)
  order Int    @default(0)

  projects ProjectTech[]

  @@map("tech_stack_items")
}

// ---------- Hakkımda ----------

model AboutSection {
  id        Int      @id @default(autoincrement())
  content   String
  photoId   Int?     @map("photo_id")
  order     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  photo Media? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@map("about_sections")
}

// ---------- Tecrübe ----------

model ExperienceSection {
  id        Int      @id @default(autoincrement())
  content   String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("experience_sections")
}

// Öğrenim ve iş hayatı roadmap'i aynı tabloda; ayıran alan `kind`.
model RoadmapItem {
  id          Int         @id @default(autoincrement())
  kind        RoadmapKind
  title       String      @db.VarChar(150)
  description String?
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime?   @map("end_date") @db.Date
  order       Int         @default(0)

  @@index([kind, order])
  @@map("roadmap_items")
}

enum RoadmapKind {
  EDUCATION
  WORK

  @@map("roadmap_kind")
}

// ---------- Projeler ----------

// slug veriye yazılır, başlıktan türetilmez: başlık değişince adres kırılmasın
// ve Türkçe harf çeviren bir yardımcıya ihtiyaç doğmasın.
// description kart özeti, body detay sayfasının anlatısı — ikisi ayrı iş.
model Project {
  id           Int       @id @default(autoincrement())
  slug         String    @unique @db.VarChar(160)
  title        String    @db.VarChar(150)
  description  String
  body         String
  role         String?   @db.VarChar(120)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  coverPhotoId Int?      @map("cover_photo_id")
  githubUrl    String?   @map("github_url") @db.VarChar(300)
  liveUrl      String?   @map("live_url") @db.VarChar(300)
  isPublished  Boolean   @default(true) @map("is_published")
  order        Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")

  coverPhoto Media?         @relation(fields: [coverPhotoId], references: [id], onDelete: SetNull)
  images     ProjectImage[]
  techStack  ProjectTech[]

  @@index([isPublished, order])
  @@map("projects")
}

// Detay sayfasının galerisi. Media 1-N: aynı görsel birden çok projede durabilir.
model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int     @map("project_id")
  mediaId   Int     @map("media_id")
  caption   String? @db.VarChar(200)
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
  @@map("project_images")
}

// Örtük N-N yerine açık model: örtük tablo _ProjectToTechStackItem adını alır,
// order taşıyamaz ve tabloların snake_case düzenini bozar.
model ProjectTech {
  projectId Int @map("project_id")
  techId    Int @map("tech_id")
  order     Int @default(0)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tech    TechStackItem @relation(fields: [techId], references: [id], onDelete: Cascade)

  @@id([projectId, techId])
  @@index([projectId, order])
  @@map("project_tech")
}
